---
// Meta strip shown under an official-plugin heading: the plugin's Tabler icon
// plus its `author/plugin` id as a badge linking to the plugin's source folder.
import '@tabler/icons-webfont/dist/tabler-icons.min.css';
interface Props {
  icon: string;
  id: string;
}

const { icon, id } = Astro.props;
const folder = id.split("/")[1] ?? id;
const repo = `https://github.com/noctalia-dev/official-plugins/tree/main/${folder}`;

---

<span class="plugin-meta">
  <span class="plugin-icon" aria-hidden="true">
    <i class:list={['ti', `ti-${icon}`]}></i>
  </span>
  <a class="plugin-id" href={repo} target="_blank" rel="noopener">{id}</a>
</span>

<style>
  .plugin-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.1rem 0 1.25rem;
  }
  .plugin-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--sl-border-radius);
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
    flex-shrink: 0;
    font-size: 1.25rem;
  }
  .plugin-id {
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--sl-color-bg-soft);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .plugin-id:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }
</style>
