---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { projectFromPath } from '../lib/projects';

const pathname = Astro.url.pathname;
const project = projectFromPath(pathname);
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const faqHref =
  project?.id === 'noctalia'
    ? '/noctalia/getting-started/faq/'
    : project?.id === 'noctalia-shell'
      ? '/noctalia-shell/getting-started/faq/'
      : undefined;
const isLegacy = project?.id === 'noctalia-shell';
---

<div class="header-inner">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="header-search sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
    <a href={faqHref ?? '#'} class="faq-button" hidden={!faqHref}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
        <path d="M12 17h.01"></path>
      </svg>
      <span>FAQ</span>
    </a>
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<div
  class="version-alert-banner is-legacy"
  role="alert"
  hidden={!isLegacy}
>
  <span class="banner-legacy">
    <strong>v4 (Quickshell) is no longer maintained.</strong> Please use <a href="/noctalia/">Noctalia v5 →</a>
  </span>
</div>

<script>
  function contextForPath(pathname: string) {
    const isCurrent = pathname === '/noctalia' || pathname.startsWith('/noctalia/');
    const isLegacy =
      pathname === '/noctalia-shell' || pathname.startsWith('/noctalia-shell/');
    return {
      isCurrent,
      isLegacy,
      faqHref: isCurrent
        ? '/noctalia/getting-started/faq/'
        : isLegacy
          ? '/noctalia-shell/getting-started/faq/'
          : undefined,
    };
  }

  function updateHeaderContext() {
    const context = contextForPath(window.location.pathname);
    const faqButton = document.querySelector<HTMLAnchorElement>('.faq-button');
    if (faqButton) {
      faqButton.hidden = !context.faqHref;
      if (context.faqHref) faqButton.href = context.faqHref;
    }

    const banner = document.querySelector<HTMLElement>('.version-alert-banner');
    if (!banner) return;
    banner.hidden = !context.isLegacy;

    const legacyMessage = banner.querySelector<HTMLElement>('.banner-legacy');
    if (legacyMessage) legacyMessage.hidden = !context.isLegacy;
  }

  function positionBanner() {
    const banner = document.querySelector('.version-alert-banner');
    const header = document.querySelector('.header');
    if (banner && header) header.after(banner);
  }

  updateHeaderContext();
  positionBanner();
  document.addEventListener('astro:page-load', () => {
    updateHeaderContext();
    positionBanner();
  });
</script>

<style>
  .faq-button[hidden],
  .version-alert-banner[hidden] {
    display: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-nav-gap);
    width: 100%;
    height: 100%;
  }

  .title-wrapper {
    min-width: 0;
    margin: -0.25rem;
    padding: 0.25rem;
    overflow: clip;
  }

  .header-search {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .right-group,
  .social-icons {
    align-items: center;
    gap: 1rem;
  }

  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  @media (min-width: 50rem) {
    .header-inner {
      display: grid;
      grid-template-columns: var(--sl-sidebar-width) minmax(0, 1fr) var(--sl-sidebar-width);
      gap: 0;
    }

    .header-search {
      justify-content: flex-start;
      padding-inline: var(--sl-content-pad-x);
    }

    .right-group {
      justify-content: flex-end;
    }
  }

  .faq-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-bg);
    background-color: var(--sl-color-accent);
    border: 1px solid var(--sl-color-accent);
    border-radius: var(--sl-border-radius, 0.5rem);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .faq-button:hover {
    background-color: transparent;
    color: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }

  .faq-button svg {
    flex-shrink: 0;
  }

  @media (max-width: 50rem) {
    .faq-button span {
      display: none;
    }
    .faq-button {
      padding: 0.4rem;
    }
  }
</style>

<style is:global>
  .version-alert-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.5rem 1.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-align: center;
    line-height: 1.4;
    border-bottom: 2px solid;
    position: fixed;
    top: var(--sl-nav-height);
    left: 0;
    right: 0;
    z-index: var(--sl-z-index-navbar);
  }


  .version-alert-banner.is-legacy {
    color: color-mix(in srgb, var(--sl-color-orange) 90%, black);
    background-color: color-mix(in srgb, var(--sl-color-orange) 12%, var(--sl-color-bg));
    border-bottom-color: color-mix(in srgb, var(--sl-color-orange) 40%, transparent);
  }

  [data-theme='dark'] .version-alert-banner.is-legacy {
    color: color-mix(in srgb, var(--sl-color-orange) 90%, white);
  }

  .version-alert-banner.is-legacy svg,
  .version-alert-banner.is-legacy strong,
  .version-alert-banner.is-legacy a {
    color: var(--sl-color-orange);
  }

  .version-alert-banner a {
    margin-inline-start: 0.4rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    white-space: nowrap;
  }

  .version-alert-banner a:hover {
    text-decoration-thickness: 2px;
  }
</style>
