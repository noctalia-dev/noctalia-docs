---
import { Icon } from '@astrojs/starlight/components';
import project from 'virtual:starlight/project-context';
import { projectFromPath } from '../lib/projects';

const dataAttributes: DOMStringMap = {};
if (project.trailingSlash === 'never') dataAttributes['data-strip-trailing-slash'] = '';

const activeProject = projectFromPath(Astro.url.pathname);
if (activeProject) dataAttributes['data-doc-project'] = activeProject.id;
// Pagefind only has an index in production builds.
if (import.meta.env.DEV) dataAttributes['data-dev-warning'] = Astro.locals.t('search.devWarning');

const searchLabel = Astro.locals.t('search.label');
---

<site-search class={Astro.props.class} {...dataAttributes}>
	<button data-open-modal disabled aria-label={searchLabel} aria-keyshortcuts="Control+K">
		<Icon name="magnifier" />
		<span class="sl-hidden md:sl-block" aria-hidden="true">{searchLabel}</span>
		<kbd class="sl-hidden md:sl-flex" style="display: none;">
			<kbd>{Astro.locals.t('search.ctrlKey')}</kbd><kbd>K</kbd>
		</kbd>
	</button>

	<dialog style="padding:0" aria-label={searchLabel}>
		<div class="dialog-frame sl-flex">
			<div class="search-form">
				<Icon name="magnifier" class="search-icon" />
				<input
					type="text"
					name="q"
					placeholder={searchLabel}
					aria-label={searchLabel}
					aria-controls="search-results"
					aria-describedby="search-status"
					autocomplete="off"
					spellcheck="false"
					enterkeyhint="search"
				/>
				<button data-clear-search type="button" hidden aria-label="Clear search">
					<Icon name="close" />
				</button>
				<button data-close-modal class="sl-flex md:sl-hidden" type="button">
					{Astro.locals.t('search.cancelLabel')}
				</button>
			</div>

			<p id="search-status" class="search-status" role="status" aria-live="polite"></p>
			<ul id="search-results" class="search-results"></ul>
		</div>
	</dialog>
</site-search>

{
	/**
	 * This is intentionally inlined to avoid briefly showing an invalid shortcut.
	 * Purposely using the deprecated `navigator.platform` property to detect Apple devices, as the
	 * user agent is spoofed by some browsers when opening the devtools.
	 */
}
<script is:inline>
	(() => {
		const openBtn = document.querySelector('button[data-open-modal]');
		const shortcut = openBtn?.querySelector('kbd');
		if (!openBtn || !(shortcut instanceof HTMLElement)) return;
		const platformKey = shortcut.querySelector('kbd');
		if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
			platformKey.textContent = '⌘';
			openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
		}
		shortcut.style.display = '';
	})();
</script>

<script>
	import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

	/** Pages shown per query. Beyond this, more results add noise, not answers. */
	const MAX_PAGES = 6;
	/** Deep links shown under a page. */
	const MAX_SECTIONS = 2;
	/** A top result this much better than the runner-up is labelled as the best match. */
	const BEST_MATCH_RATIO = 1.35;

	interface PagefindSubResult {
		title: string;
		url: string;
		excerpt: string;
		anchor?: { element: string; id: string };
	}

	interface PagefindData {
		url: string;
		excerpt: string;
		meta: Record<string, string> & { title?: string; breadcrumb?: string; project?: string };
		sub_results: PagefindSubResult[];
	}

	interface PagefindResult {
		id: string;
		score: number;
		data: () => Promise<PagefindData>;
	}

	interface PagefindApi {
		options: (options: Record<string, unknown>) => Promise<void>;
		debouncedSearch: (
			term: string,
			options?: Record<string, unknown>,
			debounceMs?: number
		) => Promise<{ results: PagefindResult[] } | null>;
	}

	class SiteSearch extends HTMLElement {
		#dialog: HTMLDialogElement;
		#input: HTMLInputElement;
		#results: HTMLUListElement;
		#status: HTMLParagraphElement;
		#clearBtn: HTMLButtonElement;
		#formatURL: (path: string) => string;
		#filters: Record<string, string> | undefined;
		#pagefind: Promise<PagefindApi> | undefined;
		/** Guards against an earlier query resolving after a later one. */
		#queryId = 0;

		constructor() {
			super();
			const openBtn = this.querySelector<HTMLButtonElement>('button[data-open-modal]')!;
			const closeBtn = this.querySelector<HTMLButtonElement>('button[data-close-modal]')!;
			this.#dialog = this.querySelector('dialog')!;
			this.#input = this.querySelector('input[type="text"]')!;
			this.#results = this.querySelector<HTMLUListElement>('#search-results')!;
			this.#status = this.querySelector<HTMLParagraphElement>('#search-status')!;
			this.#clearBtn = this.querySelector<HTMLButtonElement>('button[data-clear-search]')!;

			const dialogFrame = this.querySelector('.dialog-frame')!;
			const shouldStrip = this.dataset.stripTrailingSlash !== undefined;
			this.#formatURL = shouldStrip
				? (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2')
				: (path: string) => path;
			const docProject = this.dataset.docProject;
			this.#filters = docProject ? { project: docProject } : undefined;

			/** Close the modal if a user clicks on a link or outside of the modal. */
			const onClick = (event: MouseEvent) => {
				const target = event.target as Node | null;
				const isLink = target instanceof Element && target.closest('a');
				if (isLink || (target && document.body.contains(target) && !dialogFrame.contains(target))) {
					this.#dialog.close();
				}
			};

			const openModal = (event?: MouseEvent) => {
				this.#dialog.showModal();
				document.body.toggleAttribute('data-search-modal-open', true);
				this.#input.focus();
				this.#input.select();
				this.#loadPagefind();
				event?.stopPropagation();
				window.addEventListener('click', onClick);
			};

			openBtn.addEventListener('click', openModal);
			openBtn.disabled = false;
			closeBtn.addEventListener('click', () => this.#dialog.close());

			this.#dialog.addEventListener('close', () => {
				document.body.toggleAttribute('data-search-modal-open', false);
				window.removeEventListener('click', onClick);
			});

			window.addEventListener('keydown', (e) => {
				if ((e.metaKey === true || e.ctrlKey === true) && e.key === 'k') {
					this.#dialog.open ? this.#dialog.close() : openModal();
					e.preventDefault();
				}
			});

			this.#input.addEventListener('input', () => this.#search(this.#input.value));
			this.#clearBtn.addEventListener('click', () => {
				this.#input.value = '';
				this.#input.focus();
				this.#search('');
			});
			this.#dialog.addEventListener('keydown', (e) => this.#onKeydown(e));

			// Warm the index up while the user is still reaching for the keyboard.
			openBtn.addEventListener('pointerenter', () => this.#loadPagefind(), { once: true });
		}

		#loadPagefind() {
			if (this.#pagefind) return this.#pagefind;
			const bundlePath = import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/';
			this.#pagefind = (async () => {
				const api = (await import(
					/* @vite-ignore */ bundlePath + 'pagefind.js'
				)) as unknown as PagefindApi;
				const { ranking, indexWeight, mergeIndex } = pagefindUserConfig;
				await api.options({ basePath: bundlePath, ranking, indexWeight, mergeIndex });
				return api;
			})();
			this.#pagefind.catch(() => {
				this.#pagefind = undefined;
			});
			return this.#pagefind;
		}

		async #search(term: string) {
			const query = term.trim();
			const queryId = ++this.#queryId;

			if (!query) {
				this.#clearBtn.hidden = true;
				this.#results.replaceChildren();
				this.#status.textContent = '';
				return;
			}
			this.#clearBtn.hidden = false;

			const devWarning = this.dataset.devWarning;
			if (devWarning) {
				this.#status.textContent = devWarning;
				return;
			}

			let search: { results: PagefindResult[] } | null;
			try {
				const pagefind = await this.#loadPagefind();
				search = await pagefind.debouncedSearch(query, { filters: this.#filters }, 150);
			} catch {
				if (queryId === this.#queryId) {
					this.#results.replaceChildren();
					this.#status.textContent = 'Search is unavailable right now.';
				}
				return;
			}

			// `null` means a newer query superseded this one mid-debounce.
			if (search === null || queryId !== this.#queryId) return;

			const total = search.results.length;
			if (total === 0) {
				this.#results.replaceChildren();
				this.#status.textContent = `No results for “${query}”.`;
				return;
			}

			const shown = search.results.slice(0, MAX_PAGES);
			const pages = await Promise.all(shown.map((result) => result.data()));
			if (queryId !== this.#queryId) return;

			const isBestMatch =
				shown.length === 1 || shown[0]!.score >= (shown[1]?.score ?? 0) * BEST_MATCH_RATIO;

			this.#status.textContent =
				total > shown.length
					? `Top ${shown.length} of ${total} matches for “${query}”. Add another word to narrow it down.`
					: `${total} ${total === 1 ? 'match' : 'matches'} for “${query}”.`;

			this.#results.replaceChildren(
				...pages.map((page, index) => this.#renderPage(page, index === 0 && isBestMatch))
			);
		}

		#renderPage(page: PagefindData, best: boolean): HTMLLIElement {
			const item = document.createElement('li');
			item.className = 'search-result';
			if (best) item.dataset.best = '';

			const link = document.createElement('a');
			link.className = 'result-page';
			link.href = this.#formatURL(page.url);

			// Unscoped search (docs landing page) spans every project, so pages that
			// share a title need the project name to be told apart. Scoped search
			// shows the sidebar section, falling back to the project name for pages
			// that sit at a project's root.
			const crumbs = this.#filters ? [] : [page.meta.project];
			if (page.meta.breadcrumb) crumbs.push(page.meta.breadcrumb);
			else if (crumbs.length === 0) crumbs.push(page.meta.project);
			const breadcrumb = crumbs.filter(Boolean).join(' › ');
			if (breadcrumb) {
				const crumb = document.createElement('span');
				crumb.className = 'result-breadcrumb';
				crumb.textContent = breadcrumb;
				link.append(crumb);
			}

			const title = document.createElement('span');
			title.className = 'result-title';
			title.textContent = page.meta.title || page.url;
			if (best) {
				const badge = document.createElement('span');
				badge.className = 'result-badge';
				badge.textContent = 'Best match';
				title.append(badge);
			}
			link.append(title);

			const excerpt = document.createElement('span');
			excerpt.className = 'result-excerpt';
			// Pagefind excerpts only contain `<mark>` wrappers around our own content.
			excerpt.innerHTML = page.excerpt;
			link.append(excerpt);
			item.append(link);

			const sections = this.#pickSections(page);
			if (sections.length > 0) {
				const list = document.createElement('ul');
				list.className = 'result-sections';
				for (const section of sections) {
					const sectionItem = document.createElement('li');
					const sectionLink = document.createElement('a');
					sectionLink.href = this.#formatURL(section.url);
					const label = document.createElement('span');
					label.className = 'section-title';
					label.textContent = section.title;
					sectionLink.append(label);
					sectionItem.append(sectionLink);
					list.append(sectionItem);
				}
				item.append(list);
			}

			return item;
		}

		/** Deep links worth showing: anchored, distinct from the page itself, deduped by heading. */
		#pickSections(page: PagefindData) {
			const pageTitle = (page.meta.title || '').toLowerCase();
			const seen = new Set<string>();
			const sections: PagefindSubResult[] = [];
			for (const sub of page.sub_results) {
				if (!sub.url.includes('#') || !sub.title) continue;
				const key = sub.title.toLowerCase();
				if (key === pageTitle || seen.has(key)) continue;
				seen.add(key);
				sections.push(sub);
				if (sections.length === MAX_SECTIONS) break;
			}
			return sections;
		}

		#onKeydown(event: KeyboardEvent) {
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			const links = [...this.#results.querySelectorAll<HTMLAnchorElement>('a')];
			if (links.length === 0) return;

			const active = document.activeElement;
			const current = active instanceof HTMLAnchorElement ? links.indexOf(active) : -1;
			event.preventDefault();

			if (event.key === 'ArrowDown') {
				links[current + 1 >= links.length ? 0 : current + 1]!.focus();
				return;
			}
			if (current <= 0) this.#input.focus();
			else links[current - 1]!.focus();
		}
	}
	customElements.define('site-search', SiteSearch);
</script>

<style>
	@layer starlight.core {
		site-search {
			display: contents;
		}
		button[data-open-modal] {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			border: 0;
			background-color: transparent;
			color: var(--sl-color-gray-1);
			cursor: pointer;
			height: 2.5rem;
			font-size: var(--sl-text-xl);
		}

		@media (min-width: 50rem) {
			button[data-open-modal] {
				border: 1px solid var(--sl-color-gray-5);
				border-radius: var(--sl-border-radius);
				padding-inline-start: 0.75rem;
				padding-inline-end: 0.5rem;
				background-color: var(--sl-color-black);
				color: var(--sl-color-gray-2);
				font-size: var(--sl-text-sm);
				width: 100%;
				max-width: 22rem;
			}
			button[data-open-modal]:hover {
				border-color: var(--sl-color-gray-2);
				color: var(--sl-color-white);
			}

			button[data-open-modal] > :last-child {
				margin-inline-start: auto;
			}
		}

		button > kbd {
			border-radius: var(--radius-sm);
			font-size: var(--sl-text-2xs);
			gap: 0.25em;
			padding-inline: 0.375rem;
			background-color: var(--sl-color-gray-6);
		}

		kbd {
			font-family: var(--__sl-font);
		}

		dialog {
			margin: 0;
			background-color: var(--sl-color-gray-6);
			border: 1px solid var(--sl-color-gray-5);
			width: 100%;
			max-width: 100%;
			height: 100%;
			max-height: 100%;
			box-shadow: var(--sl-shadow-lg);
		}
		dialog[open] {
			display: flex;
		}

		dialog::backdrop {
			background-color: var(--sl-color-backdrop-overlay);
			-webkit-backdrop-filter: blur(0.25rem);
			backdrop-filter: blur(0.25rem);
		}

		.dialog-frame {
			position: relative;
			overflow: auto;
			flex-direction: column;
			flex-grow: 1;
			gap: 0.75rem;
			padding: 1rem;
		}

		/* Search field */
		.search-form {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			position: sticky;
			top: 0;
			z-index: 1;
			padding: 0.25rem 0.75rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: var(--sl-border-radius);
			background-color: var(--sl-color-black);
		}

		.search-form:focus-within {
			border-color: var(--sl-color-accent);
		}

		.search-icon {
			flex-shrink: 0;
			font-size: 1.25rem;
			color: var(--sl-color-gray-2);
		}

		/* A text input, not `type="search"`: Escape must close the dialog rather
		   than being swallowed to clear the field. Clearing is the button below. */
		input[type='text'] {
			flex-grow: 1;
			min-width: 0;
			padding: 0.625rem 0;
			border: 0;
			background: transparent;
			color: var(--sl-color-white);
			font: inherit;
			font-size: var(--sl-text-lg);
		}

		input[type='text']:focus {
			outline: none;
		}

		button[data-clear-search] {
			display: flex;
			flex-shrink: 0;
			padding: 0.25rem;
			border: 0;
			border-radius: var(--radius-sm);
			background: transparent;
			color: var(--sl-color-text-accent);
			cursor: pointer;
		}

		button[data-clear-search]:hover {
			background-color: var(--sl-color-gray-5);
		}

		button[data-close-modal] {
			flex-shrink: 0;
			padding: 0.25rem 0.5rem;
			border: 0;
			background: transparent;
			color: var(--sl-color-text-accent);
			font: inherit;
			cursor: pointer;
		}

		/* Status line; result rows are created in JS, so they are styled globally below. */
		.search-status {
			margin: 0;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs);
		}

		.search-status:empty {
			display: none;
		}

		@media (min-width: 50rem) {
			dialog {
				margin: 4rem auto auto;
				border-radius: var(--sl-border-radius);
				width: 90%;
				max-width: 40rem;
				height: max-content;
				min-height: 9rem;
				max-height: calc(100% - 8rem);
			}

			.dialog-frame {
				padding: 1.5rem;
			}
		}
	}
</style>

<style is:global>
	@layer starlight.core {
		[data-search-modal-open] {
			overflow: hidden;
		}

		/* Result rows are built in JS and therefore cannot carry Astro's scope
		   attribute; the `#search-results` id keeps these rules contained. */
		#search-results {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		#search-results .search-result {
			border: 1px solid var(--sl-color-gray-5);
			border-radius: var(--sl-border-radius);
			background-color: var(--sl-color-black);
			overflow: hidden;
		}

		#search-results .search-result[data-best] {
			border-color: var(--sl-color-accent);
		}

		#search-results .result-page {
			display: flex;
			flex-direction: column;
			gap: 0.125rem;
			padding: 0.75rem 1rem;
			text-decoration: none;
			color: var(--sl-color-white);
		}

		#search-results .result-breadcrumb {
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-2xs);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		#search-results .result-title {
			display: flex;
			align-items: baseline;
			flex-wrap: wrap;
			gap: 0.5rem;
			font-size: var(--sl-text-base);
			font-weight: 600;
		}

		#search-results .result-badge {
			padding: 0.0625rem 0.375rem;
			border-radius: 999px;
			background-color: var(--sl-color-accent-low);
			color: var(--sl-color-white);
			font-size: var(--sl-text-2xs);
			font-weight: 400;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		#search-results .result-excerpt {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			overflow: hidden;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			line-height: 1.5;
			overflow-wrap: anywhere;
		}

		#search-results .result-sections {
			display: flex;
			flex-wrap: wrap;
			gap: 0.375rem;
			margin: 0;
			padding: 0 1rem 0.75rem;
			list-style: none;
		}

		#search-results .result-sections a {
			display: block;
			padding: 0.1875rem 0.5rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 999px;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-xs);
			text-decoration: none;
		}

		#search-results .result-page:hover,
		#search-results .result-page:focus-visible,
		#search-results .result-sections a:hover,
		#search-results .result-sections a:focus-visible {
			outline: none;
			background-color: var(--sl-color-accent-low);
			color: var(--sl-color-white);
		}

		#search-results .result-page:hover .result-excerpt,
		#search-results .result-page:focus-visible .result-excerpt {
			color: var(--sl-color-white);
		}

		#search-results mark {
			background-color: transparent;
			color: var(--sl-color-text-accent);
			font-weight: 600;
		}
	}
</style>
